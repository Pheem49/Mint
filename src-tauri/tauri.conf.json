{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mint",
  "version": "1.13.0",
  "identifier": "com.pheem49.mint",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop:ui",
    "devUrl": "http://localhost:9000",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Mint Agent",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "transparent": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.config/mint/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["deb", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
