{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mint Companion",
  "version": "1.16.0",
  "identifier": "com.pheem49.mint-companion",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui",
    "devUrl": "http://localhost:9001",
    "frontendDist": "../../../out/companion"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Mint Companion",
        "width": 480,
        "height": 800,
        "minWidth": 340,
        "minHeight": 560,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "shortDescription": "An optional Live2D companion for Mint",
    "longDescription": "A floating character and plain chat client that connects locally to a running Mint instance."
  }
}
