{
  "name": "@pheem49/mint",
  "version": "1.16.0",
  "description": "A native Tauri desktop AI assistant with a Rust backend and React UI.",
  "scripts": {
    "dev:web": "vite --config vite.config.web.ts",
    "preview:web": "vite preview --config vite.config.web.ts",
    "web": "cargo run -p mint-cli -- web",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build --config vite.config.web.ts && cp out/web/index-web.html out/web/index.html",
    "dev:desktop": "npm run dev:desktop:ui",
    "build:desktop:ui": "vite build",
    "build:desktop": "node src/bin/desktop.js build",
    "build:desktop:fast": "node src/bin/desktop.js build --fast",
    "build:desktop:bundle": "npm run package --",
    "build:cli": "cargo build -p mint-cli --release",
    "cli:rebuild": "npm run build:cli && node src/bin/index.js",
    "cli:dev": "cargo run -p mint-cli --",
    "install:cli": "cargo install --path crates/mint-cli --locked",
    "build:all": "npm run build:web && npm run build:desktop && npm run build:cli",
    "tauri": "tauri",
    "tauri:dev": "npm run dev --",
    "tauri:build": "npm run package --",
    "package": "node src/bin/desktop.js package",
    "rust:cli": "cargo run -p mint-cli --",
    "rust:test": "cargo test -p mint-core -p mint-cli",
    "dev": "tauri dev",
    "build": "npm run build:ui",
    "preview": "vite preview",
    "start": "node src/bin/desktop.js start",
    "start:release": "npm start -- --release",
    "launch": "npm start --",
    "start:rebuild": "npm start -- --rebuild",
    "test": "npm run test:launchers && npm run test:interfaces && npm run test:styles && npm run test:device && npm run test:companion && cargo test -p mint-core -p mint-cli -p mint-companion-protocol -p mint-companion",
    "test:launchers": "node --test src/bin/web.test.js src/bin/index.test.js src/bin/desktop.test.js src/bin/package.test.js",
    "test:interfaces": "vitest run src/renderer/shared/components/ApprovalCard.test.tsx src/renderer/shared/utils/notificationSettings.test.ts src/renderer/shared/components/Settings/NotificationsTab.test.tsx src/renderer/shared/utils/notifications.test.ts src/renderer/shared/utils/contextCompaction.test.tsx src/renderer/shared/platform.test.ts src/renderer/shared/conversation/coordinator.test.ts src/renderer/shared/conversation/syncView.test.ts src/renderer/shared/utils/cardJson.test.ts src/renderer/shared/utils/agentActivity.test.ts src/renderer/shared/components/CliSessionsView.test.tsx src/renderer/shared/components/Settings/MemoryTab.test.tsx src/renderer/shared/theme/themeManager.test.ts src/renderer/shared/components/SelectField.test.tsx src/renderer/shared/components/VoicePill.test.tsx src/renderer/shared/utils/nativeRecordingSession.test.ts src/renderer/shared/components/GeminiLiveOverlay.test.tsx src/renderer/shared/utils/mcpResults.test.tsx src/renderer/shared/conversation/projectNavigation.test.ts src/renderer/shared/components/WorkspacePreviewActions.test.tsx src/renderer/shared/utils/workspacePreview.test.ts src/renderer/shared/utils/artifactBrowser.test.ts src/renderer/shared/utils/workspacePane.test.ts src/renderer/shared/utils/workspaceSnapshot.test.ts",
    "cli": "node src/bin/index.js",
    "prepublishOnly": "npm run build:web",
    "postinstall": "cargo build -p mint-cli --release",
    "dev:desktop:ui": "vite",
    "build:ui": "npm run build:desktop:ui && npm run build:web",
    "test:device": "node --test examples/device-mcp/server.test.mjs",
    "dev:companion": "npm run dev --workspace @mint/companion --",
    "build:companion": "npm run build --workspace @mint/companion --",
    "package:companion": "npm run package --workspace @mint/companion --",
    "test:companion": "vitest run --root . apps/mint-companion/src/state.test.ts",
    "typecheck:companion": "npm run typecheck --workspace @mint/companion",
    "test:styles": "node --test src/bin/styles.test.js"
  },
  "keywords": [
    "mint",
    "tauri",
    "ai",
    "assistant",
    "desktop",
    "cli",
    "rust",
    "react",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pheem49/Mint.git"
  },
  "bugs": {
    "url": "https://github.com/Pheem49/Mint/issues"
  },
  "homepage": "https://github.com/Pheem49/Mint#readme",
  "author": {
    "name": "Pheem49",
    "email": "killerpheem13@gmail.com"
  },
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "bin": {
    "mint": "src/bin/index.js",
    "mint-web": "src/bin/web.js"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/kanit": "^5.3.0",
    "@fontsource/mali": "^5.3.0",
    "@fontsource/mitr": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/prompt": "^5.3.0",
    "@fontsource/sarabun": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@lobehub/icons-static-svg": "^1.95.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "luxon": "^3.7.2",
    "material-icon-theme": "5.34.0",
    "mermaid": "^11.17.0",
    "ogl": "^1.0.11",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/luxon": "^3.7.4",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "gh-pages": "^5.0.0",
    "@modelcontextprotocol/sdk": "^1.24.0",
    "nodemailer": "^9.0.0",
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.12",
    "@hono/node-server": "^2.0.5"
  },
  "workspaces": [
    "apps/mint-companion"
  ],
  "files": [
    "src",
    "crates",
    "scripts",
    "examples",
    "shared-modules",
    "out/web",
    "Cargo.toml",
    "Cargo.lock",
    "Release_Note.md",
    "slash-commands.json",
    "mcp-registry.json",
    "README.md",
    "LICENSE",
    "vite.config.ts",
    "vite.config.web.ts",
    "tsconfig.json",
    "tsconfig.node.json",
    "components.json",
    "src-tauri/Cargo.toml",
    "src-tauri/src",
    "src-tauri/build.rs",
    "apps/mint-companion/src-tauri/Cargo.toml",
    "apps/mint-companion/src-tauri/src",
    "apps/mint-companion/src-tauri/build.rs"
  ]
}
